{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchtower.local/schemas/result.schema.json",
  "title": "Watchtower result protocol",
  "oneOf": [{"$ref": "#/$defs/check"}, {"$ref": "#/$defs/command"}],
  "$defs": {
    "finding": {
      "type": "object", "required": ["rule_id", "finding_id", "evidence_digest", "path", "start_byte", "end_byte", "kind", "mode", "severity", "blocking", "message", "help"],
      "properties": {
        "rule_id": {"type": "string"}, "finding_id": {"type": "string"},
        "evidence_digest": {"type": "string"}, "path": {"type": "string"},
        "start_byte": {"type": "integer", "minimum": 0}, "end_byte": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["review", "violation"]}, "mode": {"enum": ["advisory", "enforced", "disabled"]},
        "severity": {"enum": ["error", "warning", "info"]}, "blocking": {"type": "boolean"},
        "message": {"type": "string"}, "help": {"type": "string"},
        "status": {"enum": ["needs_review", "confirmed_issue", "violation", "accepted"]},
        "finding_prefix": {"type": "string"}, "evidence_prefix": {"type": "string"},
        "snippet": {"type": ["object", "null"]}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "command", "status", "exit_code", "detail", "complete", "scope", "root", "policy_digest", "effective_policy", "coordinate_encoding", "diagnostics", "errors", "notices", "rules", "summary", "gaps", "coverage_expectations", "inventory"],
      "properties": {
        "schema_version": {"const": 1}, "command": {"const": "check"}, "status": {"type": "string"},
        "exit_code": {"enum": [0,1,2,130]}, "detail": {"enum": ["summary", "full"]},
        "complete": {"type": "boolean"}, "root": {"type": "string"},
        "preview": {"type": "boolean"},
        "scope": {"type": "object"}, "changed_base": {"type": ["string", "null"]},
        "policy_digest": {"type": "string"}, "effective_policy": {"type": "object"},
        "coordinate_encoding": {"const": "unicode-scalar-columns"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "reviewed": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "files": {"type": "array"}, "review_records": {"type": "array"},
        "errors": {"type": "array"}, "notices": {"type": "array"},
        "rules": {"type": "array"}, "gaps": {"type": "array"},
        "coverage_expectations": {"type": "array"},
        "summary": {"type": "object", "required": ["raw_occurrences", "actionable_occurrences", "reviewed_occurrences", "blocking_diagnostics", "checked_files"]},
        "inventory": {"type": "object", "additionalProperties": false, "required": ["reviewed", "files", "review_records"], "properties": {"reviewed": {"type": "boolean"}, "files": {"type": "boolean"}, "review_records": {"type": "boolean"}}},
        "stats": {"type": "object"}
      },
      "allOf": [{"if": {"properties": {"detail": {"const": "full"}}}, "then": {"required": ["reviewed", "files", "review_records"]}, "else": {"not": {"anyOf": [{"required": ["reviewed"]}, {"required": ["files"]}, {"required": ["review_records"]}]}}}]
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "command", "status", "exit_code", "detail", "data", "stages", "errors", "notices"],
      "properties": {
        "schema_version": {"const": 1}, "command": {"type": "string"},
        "status": {"type": "string"}, "exit_code": {"enum": [0,1,2,130]},
        "detail": {"enum": ["summary", "full"]}, "data": {"type": "object"},
        "stages": {"type": "array"}, "errors": {"type": "array"}, "notices": {"type": "array"}
      }
    }
  }
}
