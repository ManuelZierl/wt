{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchtower.local/schemas/config.schema.json",
  "title": "Watchtower configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 2},
    "scan": {"$ref": "#/$defs/scan"},
    "rules": {"$ref": "#/$defs/rules"}
  },
  "$defs": {
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "respect_gitignore": {"type": "boolean", "default": true},
        "honor_git_local_excludes": {"type": "boolean", "default": true},
        "include_hidden": {"type": "boolean", "default": true},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864, "default": 4194304},
        "exclude": {"type": "array", "items": {"$ref": "#/$defs/exclude"}}
      }
    },
    "exclude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glob", "reason"],
      "properties": {
        "glob": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\).+$"},
        "reason": {"type": "string", "pattern": ".*\\S.*"}
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode_overrides": {"type": "object", "propertyNames": {"pattern": "^(?:global|local)/[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"}, "additionalProperties": {"$ref": "#/$defs/mode-override"}}
      }
    },
    "mode-override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {"mode": {"enum": ["advisory", "enforced", "disabled"]}, "reason": {"type": "string", "pattern": ".*\\S.*"}}
    }
  }
}
