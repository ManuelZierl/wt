{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchtower.local/schemas/review.schema.json",
  "title": "Evidence-bound occurrence review (safe paths and identity consistency also checked at runtime)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "evidence_digest",
    "matched_digest",
    "rule_digest",
    "file_digest",
    "schema_version",
    "decision",
    "rule_id",
    "code",
    "path",
    "start_byte",
    "end_byte",
    "watched_files",
    "rationale_file",
    "previous",
    "context_digest",
    "engine_digest"
  ],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "matched_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rule_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "schema_version": {"const": 1},
    "decision": {"enum": ["needs_review", "acceptable", "confirmed_issue", "accepted_risk"]},
    "rule_id": {"type": "string", "minLength": 1},
    "code": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "start_byte": {"type": "integer", "minimum": 0},
    "end_byte": {"type": "integer", "minimum": 0},
    "watched_files": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "rationale_file": {"const": "rationale.md"},
    "previous": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "engine_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
