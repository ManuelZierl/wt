{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchtower.local/schemas/config-v2.schema.json",
  "title": "Watchtower configuration schema 2",
  "type": "object", "additionalProperties": false, "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 2},
    "scan": {"type": "object", "additionalProperties": false, "properties": {
      "respect_gitignore": {"type": "boolean"}, "honor_git_local_excludes": {"type": "boolean"},
      "include_hidden": {"type": "boolean"},
      "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
      "exclude": {"type": "array", "items": {"type": "object", "additionalProperties": false,
        "required": ["glob", "reason"], "properties": {"glob": {"type": "string"}, "reason": {"type": "string"}}}}
    }},
    "rules": {"type": "object", "additionalProperties": false, "properties": {
      "mode_overrides": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
        "required": ["mode", "reason"], "properties": {"mode": {"enum": ["advisory", "enforced", "disabled"]}, "reason": {"type": "string"}}}}
    }}
  }
}
