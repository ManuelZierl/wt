for m in file.ast_match(
    "tsx",
    "<input $$$ type={$PARAM . type === \"number\" ? \"number\" : \"text\"} $$$/>"
) {
    if !m.ast_match("tsx", "<input $$$ step={\"any\"} $$$/>").is_empty() {
        continue;
    }
    if !m.ast_match("tsx", "<input $$$ step=\"any\" $$$/>").is_empty() {
        continue;
    }

    let parameter = m.node("PARAM").text;
    let conditional_ok = false;
    for cond in m.ast_match(
        "tsx",
        "<input $$$ step={$P . type === \"number\" ? \"any\" : undefined} $$$/>"
    ) {
        if cond.node("P").text == parameter {
            conditional_ok = true;
        }
    }
    if conditional_ok {
        continue;
    }

    let has_step_expr = m.ast_match("tsx", "<input $$$ step={$ANY} $$$/>");
    let has_step_str = m.ast_match("tsx", "<input $$$ step=\"$ANY\" $$$/>");
    if has_step_expr.is_empty() && has_step_str.is_empty() {
        emit(m.span, "decimal-step");
        continue;
    }

    if !m.ast_match("tsx", "<input $$$ step={\"1\"} $$$/>").is_empty()
        || !m.ast_match("tsx", "<input $$$ step=\"1\" $$$/>").is_empty()
        || !m.ast_match("tsx", "<input $$$ step={1} $$$/>").is_empty() {
        emit(m.span, "decimal-step");
        continue;
    }

    emit(m.span, "unverified-step");
}
